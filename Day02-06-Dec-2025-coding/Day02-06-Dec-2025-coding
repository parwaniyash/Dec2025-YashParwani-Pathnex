#Ansible Playbook
---
-name:Install and Enable Nginx
 hosts:all
 become:yes

 tasks:
  -name:Install Nginx
   ansible.builtin.apt:
   name:Nginx
   state:present

  -name:Enable Nginx
   ansible.builtin.service
   name:Nginx
   state:started
   enabled:yes
