#Ansible
- name: Install nginx
  hosts: all
  become: yes
  tasks:
    - name: Install nginx package
      yum:
        name: nginx
        state: present

#Terraform
resource "aws_s3_bucket" "pathnex_bucket" {
  bucket = "pathnex-bucket"
  acl    = "public-read"
}

#Kubernetes
apiVersion: v1
kind: Pod
metadata:
  name: brokenpod
spec:
  containers:
    - name: app
      image: nginx
#Jenkins
pipeline {
    agent any
    environment {
        INSTITUTE_NAME = "Pathnex"
        TEAM = "DevOps"
        ENV = "prod"
    }
    stages {
        stage('Deploy') {
            steps {
                script {
                    try {
                        sh 'echo "Deploying $INSTITUTE_NAME app in $ENV for $TEAM"'
                        sh 'exit 1' // simulate failure
                    } catch (Exception e) {
                        echo "Deployment failed. Rolling back $INSTITUTE_NAME app in $ENV"
                    }
                }
            }
        }
    }
}

#GitlabCI
stages:
  - deploy

variables:
  INSTITUTE_NAME: "Pathnex"
  TEAM = "DevOps"
  ENV = "prod"

deploy:
  stage: deploy
  image: alpine:latest
  script:
    - echo "Deploying $INSTITUTE_NAME app in $ENV for $TEAM"
    - exit 1
  after_script:
    - echo "Deployment failed. Rolling back $INSTITUTE_NAME app in $ENV"

